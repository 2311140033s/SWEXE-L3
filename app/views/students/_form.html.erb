<%= form_for @student do |f| %>
  <% if @student.errors.any? %>
    <div style="color: red;">
      <h2><%= pluralize(@student.errors.count, "エラー") %>があります：</h2>
      <ul>
        <% @student.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p>
    <%= f.label :student_number, '学籍番号' %><br>
    <%= f.text_field :student_number %>
  </p>

  <p>
    <%= f.label :name, '氏名' %><br>
    <%= f.text_field :name %>
  </p>

  <p>
    <%= f.label :email, 'メールアドレス' %><br>
    <%= f.text_field :email %>
  </p>

  <p>
    <%= f.submit '登録する' %>
  </p>
<% end %>
